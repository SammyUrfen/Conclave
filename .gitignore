# Compiled binaries / build output — never commit these.
/bin/
*.exe
*.test
/server
/peer
/conclave

# Test & coverage artifacts
coverage.out
coverage.html
*.prof

# Go workspace files (machine-local)
go.work
go.work.sum

# Media captured by later phases (save-to-disk, play-from-disk, etc.) and the quality
# layers scripts/make-layers.sh generates. The SCRIPT is the artifact worth committing;
# the encodes are megabytes and reproducible from it.
*.ivf
*.ogg
*.h264
*.mp4

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/

# Local tool caches (serena code-intelligence index, etc.) — machine-local, not project source
.serena/

# Playwright MCP scratch output from local UI verification
.playwright-mcp/
